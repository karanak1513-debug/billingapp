# Snacks O'Clock Cloud Backend Configuration Template
PORT=8080
NODE_ENV=development

# Database configuration (PostgreSQL) - Required only when cloud sync is activated
DATABASE_URL=postgresql://user:password@localhost:5432/snacks_oclock_db

# Security & Tokens
API_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
